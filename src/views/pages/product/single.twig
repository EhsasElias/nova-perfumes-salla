{% extends "layouts.master" %}

{% block content %}
<section class="nova-product-page nova-container" id="product-{{ product.id }}">
  <div class="nova-product-breadcrumb"><salla-breadcrumb></salla-breadcrumb></div>

  <div class="nova-product-grid">
    <div class="nova-gallery">
      <salla-slider
        data-testid="store-product-image-slider"
        id="details-slider-{{ product.id }}"
        class="nova-product-slider"
        data-images='{{ product.images|json_encode }}'
        type="thumbs"
        loop="false"
        auto-height>
        <div slot="items">
          {% for image in product.images %}
            <a class="swiper-slide nova-product-slide" href="{{ image.url }}" data-fslightbox="product_{{ product.id }}" aria-label="{{ product.name }}">
              <img src="{{ image.url }}" alt="{{ image.alt ?: product.name }}" loading="{{ loop.first ? 'eager' : 'lazy' }}">
            </a>
          {% endfor %}
        </div>
        {% if product.images|length > 1 %}
          <div slot="thumbs">
            {% for image in product.images %}
              <div class="slide--one-fourth"><img src="{{ image.url }}" alt="{{ image.alt ?: product.name }}" loading="lazy"></div>
            {% endfor %}
          </div>
        {% endif %}
      </salla-slider>
    </div>

    <div class="nova-product-info">
      {% if product.brand.name %}
        <a class="nova-brand" href="{{ product.brand.url }}">{{ product.brand.name }}</a>
      {% endif %}

      <h1>{{ product.name }}</h1>
      {% if product.subtitle %}<p class="nova-product-subtitle">{{ product.subtitle }}</p>{% endif %}

      {% if product.rating %}
        <salla-rating-stars value="{{ product.rating.stars }}" reviews="{{ product.rating.count }}"></salla-rating-stars>
      {% endif %}

      <div class="nova-price">
        {% if product.is_on_sale %}
          <strong>{{ product.sale_price|money }}</strong>
          <del>{{ product.regular_price|money }}</del>
        {% else %}
          <strong>{{ product.starting_price ? product.starting_price|money : product.price|money }}</strong>
        {% endif %}
      </div>

      <div class="nova-product-description">{{ product.description|raw }}</div>

      <form class="nova-product-form" enctype="multipart/form-data" method="post" onsubmit="return salla.form.onSubmit('cart.addItem', event)">
        <input type="hidden" name="id" value="{{ product.id }}">

        {% include 'pages.partials.product.options' with { product: product } %}

        {% if not product.is_hidden_quantity %}
          <div class="nova-quantity-row">
            <span>{{ trans('pages.products.quantity') }}</span>
            <salla-quantity-input max="{{ product.max_quantity }}" value="1" name="quantity" aria-label="Quantity"></salla-quantity-input>
          </div>
        {% endif %}

        <salla-add-product-button
          data-testid="store-product-add-to-cart"
          {{ product.can_quick_buy ? 'quick-buy' : '' }}
          {{ product.is_require_shipping ? 'required-shipping' : '' }}
          width="wide"
          product-status="{{ product.status }}"
          product-id="{{ product.id }}"
          product-type="{{ product.type }}">
          {{ product.add_to_cart_label }}
        </salla-add-product-button>
      </form>

      <div class="nova-product-meta">
        {% if product.sku %}<span><b>SKU</b> {{ product.sku }}</span>{% endif %}
        {% if product.category %}<a href="{{ product.category.url }}">{{ product.category.name }}</a>{% endif %}
        {% if product.is_taxable %}<span>{{ trans('pages.products.tax_included') }}</span>{% endif %}
      </div>
    </div>
  </div>
</section>
{% endblock %}
