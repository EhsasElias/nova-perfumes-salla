{% extends "layouts.master" %}

{% block content %}
<section class="nova-page-head">
  <div class="nova-container">
    <salla-breadcrumb></salla-breadcrumb>
    <div class="nova-page-head-row">
      <div>
        <p class="nova-eyebrow">NOVA CATALOG</p>
        <h1>{{ page.title|raw }}</h1>
      </div>
      {% if sort_options|length %}
        <label class="nova-sort">
          <span>{{ trans('pages.categories.sorting') }}</span>
          <select id="product-filter">
            {% for sort in sort_options %}
              <option value="{{ sort.id }}" {{ sort.is_selected ? 'selected' : '' }}>{{ sort.name }}</option>
            {% endfor %}
          </select>
        </label>
      {% endif %}
    </div>
  </div>
</section>

<section class="nova-catalog nova-container">
  <div class="nova-catalog-grid">
    {% if filters %}
      <aside class="nova-filters">
        <salla-filters data-testid="store-products-filters" id="filters-menu"></salla-filters>
      </aside>
    {% endif %}

    <div class="nova-products-list-wrap">
      {% set sort_list = sort_options|default([]) %}
      {% set first_sort = sort_list|first %}
      {% set has_selected_sort = sort_list|filter(sort => sort.is_selected)|length %}
      {% set fallback_sort = (sort_list|length and not has_selected_sort and first_sort.id != 'ourSuggest') ? first_sort.id : '' %}

      <salla-products-list
        data-testid="store-products-list"
        source="{{ page.slug }}"
        source-value="{{ page.id }}"
        sort-by="{{ fallback_sort }}"
        {{ filters ? 'filters-results' : '' }}>
      </salla-products-list>
    </div>
  </div>
</section>
{% endblock %}
